# tenderX Environment Configuration Template

# Django Backend Settings
SECRET_KEY=django-insecure-tenderx-module1-default-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=*
# Local VS Code development uses SQLite by default. Docker Compose overrides this.
USE_SQLITE=True

# PostgreSQL Database Configuration
POSTGRES_DB=tenderx_db
POSTGRES_USER=tenderx_user
POSTGRES_PASSWORD=tenderx_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis & Celery Configuration
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
