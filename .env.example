# tenderX Environment Configuration Template

# Django Backend Settings
SECRET_KEY=django-insecure-tenderx-module1-default-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=*
# Local VS Code development uses SQLite by default. Docker Compose overrides this.
USE_SQLITE=True

# PostgreSQL Database Configuration
POSTGRES_DB=tenderx_db
POSTGRES_USER=tenderx_user
POSTGRES_PASSWORD=tenderx_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis & Celery Configuration
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# AWS S3 & Cloud Document Storage (Module 8)
# In production, configure IAM role or provide AWS credentials
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=tenderx-documents-production
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/your-kms-key-id
AWS_S3_CUSTOM_ENDPOINT=
STORAGE_PROVIDER=AUTO
DOCUMENT_PRESIGNED_EXPIRATION_SECONDS=900

